# Copy to web/.env.local (and set the same names as GitHub Actions secrets for jobs/).
# Never commit real values. Only NEXT_PUBLIC_* values are sent to the browser.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Auth accepts this public key instead of the legacy anon JWT, when configured:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required for production Auth: the exact HTTPS app origin, without a path.
NIRMOL_SITE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # server/jobs only

GEMINI_API_KEY=                 # https://aistudio.google.com/apikey
# Optional F06 only; disabled unless exactly true AND both server settings exist.
# Choose an approved structured-output-capable Gemini model; no default is assumed.
GEMINI_REPORT_MODEL=
NIRMOL_REPORT_AI_ENABLED=false
# Optional F08; requires reviewed 0006 quota RPCs and a separately chosen model.
NIRMOL_ADVISOR_ENABLED=false
GEMINI_ADVISOR_MODEL=
# At least 32 random server-only characters; used for guest cookies/request HMACs.
NIRMOL_ADVISOR_COOKIE_SECRET=
OPENROUTESERVICE_API_KEY=       # https://openrouteservice.org/dev/#/signup
OPENAQ_API_KEY=                 # https://explore.openaq.org/register
